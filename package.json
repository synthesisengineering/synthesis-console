{
  "name": "synthesis-console",
  "version": "1.3.3",
  "description": "Local console for synthesis engineering \u2014 browsable project state, continuity, and conformance",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "demo": "bun run src/index.ts --demo",
    "sync-slack": "bun run scripts/sync-slack-directory.ts",
    "setup-slack": "bun run scripts/setup-slack.ts",
    "typecheck": "tsc --noEmit",
    "autostart:install": "bash scripts/install-autostart-$(uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/macos/').sh",
    "autostart:uninstall": "bash scripts/uninstall-autostart-$(uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/macos/').sh"
  },
  "dependencies": {
    "hono": "^4.12.32",
    "js-yaml": "^5.2.2",
    "markdown-it": "^14.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/synthesisengineering/synthesis-console.git"
  },
  "author": "Rajiv Pant",
  "keywords": [
    "synthesis-engineering",
    "project-management",
    "conformance",
    "markdown",
    "local-first"
  ]
}
