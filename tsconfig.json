{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "scripts/console-cli.ts",
    "scripts/service-ownership.ts"
  ]
}
