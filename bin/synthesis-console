#!/bin/sh
set -eu
ENTRY=$0
while [ -L "$ENTRY" ]; do
  LINK=$(readlink "$ENTRY")
  case "$LINK" in /*) ENTRY=$LINK ;; *) ENTRY=$(dirname "$ENTRY")/$LINK ;; esac
done
ROOT=$(CDPATH= cd -- "$(dirname "$ENTRY")/.." && pwd)
if ! command -v bun >/dev/null 2>&1; then
  echo 'Synthesis Console requires Bun 1.3.13 or later.' >&2
  exit 2
fi
exec bun "$ROOT/scripts/console-cli.ts" "$@"
